#Использовать openfeature

&Пластилин Перем НастройкиФлагов;

&Дуб
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Клиент оценки флагов.
//
// Провайдер регистрируется один раз при первом обращении к клиенту:
// поле &Пластилин НастройкиФлагов к моменту конструктора ещё не заполнено.
//
// Возвращаемое значение:
//   FeatureClient - клиент оценки флагов.
//
&Завязь
Функция FeatureClient() Экспорт

	УстановитьПровайдер();

	Возврат OpenFeature.ПолучитьКлиента(НастройкиФлагов.Домен());

КонецФункции

Процедура УстановитьПровайдер()

	Если OpenFeature.МетаданныеПровайдера().Имя <> "NoopProvider" Тогда
		Возврат;
	КонецЕсли;

	Вид = НастройкиФлагов.Провайдер();

	Если Вид = "json" Тогда
		OpenFeature.УстановитьПровайдер(Новый JsonFileProvider(НастройкиФлагов.ПутьКФайлу()));
	ИначеЕсли Вид = "memory" Тогда
		OpenFeature.УстановитьПровайдер(Новый InMemoryProvider());
	КонецЕсли;

	// Значение none оставляет провайдер-заглушку: приложение получает значения
	// по умолчанию

КонецПроцедуры
