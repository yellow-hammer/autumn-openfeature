// ==============================================================================
// ПРИМЕР: Внедрение через autumn
// Что делает: поднимает провайдер флагов из секции openfeature в
//             autumn-properties.json и получает FeatureClient как желудь.
// Термины:
//   Желудь - компонент autumn, который контейнер создаёт и внедряет сам.
//   FeatureClient - клиент OpenFeature для оценки флагов в приложении.
// ==============================================================================

#Использовать autumn
#Использовать openfeature
#Использовать autumn-openfeature

Поделка = Новый Поделка;
Поделка.ЗапуститьПриложение();

// В своём приложении этой строки не будет: клиент придёт в поле желудя
Флаги = Поделка.НайтиЖелудь("FeatureClient");

Сообщить("Домен клиента: " + Флаги.Метаданные().Домен);
Сообщить("");

Сообщить("new-checkout     = " + Флаги.ПолучитьЛогическое("new-checkout", Ложь));
Сообщить("максимум-позиций = " + Флаги.ПолучитьЧисло("максимум-позиций", 10));

Обычный = Новый EvaluationContext("user-1", Новый Структура("plan", "free"));
Платный = Новый EvaluationContext("user-2", Новый Структура("plan", "pro"));

Сообщить("тема (free)      = " + Флаги.ПолучитьСтроку("тема", "нет", Обычный));
Сообщить("тема (pro)       = " + Флаги.ПолучитьСтроку("тема", "нет", Платный));

// Провайдер регистрируется при первом обращении к клиенту, поэтому его имя
// видно только после чтения флагов
Сообщить("");
Сообщить("Провайдер: " + OpenFeature.МетаданныеПровайдера().Имя);
