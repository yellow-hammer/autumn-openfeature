&Тест
&ОтображаемоеИмя("Клиент флагов собирается автоматически и читает домен из настроек")
Процедура КлиентСобираетсяАвтоматически() Экспорт

	Клиент = Поделка().НайтиЖелудь("FeatureClient");

	Ожидаем.Что(Клиент.Метаданные().Домен).Равно("демо");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Провайдер поднимается по настройкам и отдаёт значения из файла")
Процедура ПровайдерПоднимаетсяПоНастройкам() Экспорт

	Клиент = Поделка().НайтиЖелудь("FeatureClient");

	Ожидаем.Что(Клиент.ПолучитьЛогическое("new-checkout", Ложь)).ЭтоИстина();
	Ожидаем.Что(Клиент.ПолучитьЧисло("максимум-позиций", 0)).Равно(25);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Правила таргетинга применяются к внедрённому клиенту")
Процедура ТаргетингРаботает() Экспорт

	Клиент = Поделка().НайтиЖелудь("FeatureClient");

	Обычный = Новый EvaluationContext("user-1", Новый Структура("plan", "free"));
	Платный = Новый EvaluationContext("user-2", Новый Структура("plan", "pro"));

	Ожидаем.Что(Клиент.ПолучитьСтроку("тема", "нет", Обычный)).Равно("light");
	Ожидаем.Что(Клиент.ПолучитьСтроку("тема", "нет", Платный)).Равно("dark");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Настройки читаются из секции openfeature")
Процедура НастройкиЧитаютсяИзСекции() Экспорт

	Настройки = Поделка().НайтиЖелудь("НастройкиФлагов");

	Ожидаем.Что(Настройки.Провайдер()).Равно("json");
	Ожидаем.Что(Настройки.Домен()).Равно("демо");
	Ожидаем.Что(Настройки.ПутьКФайлу()).Содержит("flags.json");

КонецПроцедуры

Функция Поделка()

	Результат = Новый Поделка;
	Результат.ЗапуститьПриложение();

	Возврат Результат;

КонецФункции
